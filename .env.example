# Configuración del Servidor
NODE_ENV=production
PORT=3000
PUBLIC_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://fasttok.lat,https://www.fasttok.lat

# Funcionalidades y Publicidad
ADS_ENABLED=false
ADS_PROVIDER_SCRIPT_URL=
CONTACT_EMAIL=info@fasttok.lat
SENTRY_DSN=

# Registro de logs
LOG_LEVEL=info
MAX_JSON_SIZE=10kb

# Límites de Solicitudes (Rate Limiting)
ANALYZE_RATE_LIMIT_PER_MINUTE=10
DOWNLOAD_RATE_LIMIT_PER_MINUTE=5
DOWNLOAD_RATE_LIMIT_PER_HOUR=20

# Control de Cola y Concurrencia
MAX_GLOBAL_CONCURRENT_DOWNLOADS=3
MAX_CONCURRENT_DOWNLOADS_PER_IP=1
MAX_QUEUE_SIZE=20

# Límites de Archivo y Video
MAX_FILE_SIZE_BYTES=209715200 # 200 MB en bytes
MAX_VIDEO_DURATION_SECONDS=600 # 10 minutos
ANALYSIS_TOKEN_TTL_SECONDS=600  # 10 minutos

# Tiempos de Espera (Timeouts en milisegundos)
DOWNLOAD_TIMEOUT_MS=90000 # 90 segundos
ANALYZE_TIMEOUT_MS=20000  # 20 segundos

# Gestión y Limpieza de Temporales
TEMP_FILE_MAX_AGE_MINUTES=15
CLEANUP_INTERVAL_MINUTES=5
